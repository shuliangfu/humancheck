{
  "name": "@dreamer/humancheck",
  "version": "1.0.0-beta.1",
  "description": "人机验证库，支持图形验证码、数学验证码、滑块验证码、TOTP、短信/邮箱验证码、第三方服务集成",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./client/slider": "./src/client/slider.ts",
    "./client/recaptcha": "./src/client/recaptcha.ts",
    "./client/turnstile": "./src/client/turnstile.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable"
    ]
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "LICENSE.md",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**"
    ]
  },
  "imports": {
    "@dreamer/test": "jsr:@dreamer/test@^1.0.0-beta.40"
  },
  "tasks": {
    "test": "deno test --allow-all tests/",
    "check": "deno check src/",
    "lint": "deno lint src/"
  }
}
