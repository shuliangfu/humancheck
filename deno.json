{
  "name": "@dreamer/humancheck",
  "version": "1.0.0",
  "description": "Human verification library: image CAPTCHA, math CAPTCHA, slider CAPTCHA, TOTP, SMS/email codes, third-party integration (reCAPTCHA, Turnstile)",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./client/slider": "./src/client/slider.ts",
    "./client/recaptcha": "./src/client/recaptcha.ts",
    "./client/turnstile": "./src/client/turnstile.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable"
    ]
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/**/*.json",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**"
    ]
  },
  "imports": {
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.0.1",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.0.15",
    "@dreamer/test": "jsr:@dreamer/test@^1.0.11"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "test": "deno test --allow-all tests/",
    "check": "deno check src/",
    "lint": "deno lint src/"
  }
}
